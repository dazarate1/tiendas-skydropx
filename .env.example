# conexión a Postgres (Supabase: Project Settings → Database → URI, modo session)
DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos

# clave de cifrado de credenciales: 32 bytes en base64 → npm run keygen
CREDENTIALS_KEY=

# secreto de firma de la sesión del panel → npm run keygen
SESSION_SECRET=

# primera cuenta de asesora; se crea sola en el primer inicio de sesión
ADMIN_EMAIL=
ADMIN_PASSWORD=

# dominio raíz; las tiendas viven en <slug>.<dominio>
# desarrollo: localhost:3000 · producción: tutienda.co
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# modo demostración: las marcas SIN cuenta Skydropx conectada usan tarifas y guías
# simuladas, y pueden publicarse sin credenciales. Nunca activar en producción.
DEMO_MODE=1

# opcional hasta confirmar el esquema de firma de Skydropx
SKYDROPX_WEBHOOK_SECRET=
